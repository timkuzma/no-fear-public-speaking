# Render pilot.example.org for the deployment's exact hostname.
server {
    listen 8080;
    listen [::]:8080;
    server_name pilot.example.org;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name pilot.example.org;
    ssl_certificate /etc/no-fear-stage/letsencrypt/live/pilot.example.org/fullchain.pem;
    ssl_certificate_key /etc/no-fear-stage/letsencrypt/live/pilot.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 33m;
    client_body_timeout 120s;
    location /api/operator/ { return 404; }
    location = /customer-development.html {
        root /var/www/no-fear-stage-pages;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location / {
        # Resolve again after backup/resume replaces the application container.
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $no_fear_stage http://no-fear-stage:8080;
        proxy_pass $no_fear_stage;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
    }
}
