[Unit]
Description=Verified and encrypted No Fear Stage backup
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/no-fear-stage
ExecStart=/opt/no-fear-stage/.venv/bin/python scripts/production.py backup --root /srv/no-fear-stage
TimeoutStartSec=4h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/no-fear-stage
