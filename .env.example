# Names and safe examples only. Export into the server environment; this file is not auto-loaded.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
DATA_DIR=./data
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_MODEL=gpt-5.4
# Optional wording pass after analysis/questions; empty disables it.
FEEDBACK_EDITOR_MODEL=deepseek-v3.2
TRANSCRIPTION_MODEL=whisper-large-v3
REQUIRE_INVITE=0
MAX_UPLOAD_BYTES=33554432
DAILY_JOB_LIMIT=20
# LLM_API_KEY must be provided privately in the server environment.
# OPERATOR_TOKEN must be generated privately for operator metrics/export.

# Rolling work limits, not a monetary budget. Exact ranges: server/limits.py.
AI_ENABLED=1
AI_DAILY_ATTEMPTS=500
AI_USER_DAILY_ATTEMPTS=300
AI_REQUESTS_PER_MINUTE=30
AI_DAILY_AUDIO_SECONDS=18000
AI_DAILY_INPUT_CHARS=5000000
AI_DAILY_OUTPUT_TOKENS=600000
AI_MAX_OUTPUT_TOKENS=3000
MAX_PENDING_JOBS=20
MAX_PENDING_LIVE_CHUNKS=120
DAILY_LIVE_CHUNK_LIMIT=360
LLM_MAX_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=900
LIVE_JOB_TIMEOUT_SECONDS=180
MIN_FREE_DISK_BYTES=268435456
QUEUE_ALERT_SECONDS=300
BACKUP_MAX_AGE_SECONDS=93600
# Production controller uses private mode-0600 runtime.json/secrets.json outside Git.
# RESTIC_PASSWORD, RESTIC_REPOSITORY and optional ALERT_WEBHOOK_URL belong there.
