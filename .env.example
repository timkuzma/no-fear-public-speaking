# Names and safe examples only. Export into the server environment; this file is not auto-loaded.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
DATA_DIR=./data
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_MODEL=gigachat-3-pro
